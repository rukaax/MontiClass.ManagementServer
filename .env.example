# ===== 服务端 =====
PORT=3001
NODE_ENV=development
# 允许跨域的前端来源（多个用逗号分隔）
CORS_ORIGIN=http://localhost:5173

# ===== PostgreSQL 数据库 =====
# 连接串格式：postgresql://用户名:密码@主机:端口/数据库名
DATABASE_URL=postgresql://postgres:changeme@127.0.0.1:5432/esp32_classroom

# ===== 管理员鉴权 =====
JWT_SECRET=please-change-this-secret
# 管理员账号密码存于数据库 users 表（默认 admin / admin，bcrypt 哈希）
# 导入 schema.sql 后即创建；修改密码见 schema.sql 末尾示例

# ===== 设备上报 Token =====
# 首次启动写入数据库，之后可在「系统设置」页面修改
INITIAL_DEVICE_TOKEN=esp32-classroom-token-2026
